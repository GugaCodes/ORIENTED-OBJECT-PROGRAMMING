using System;
using System.Collections.Generic;
using System.Text;

namespace DesafioPOO2___Exercicio_2
{
    public class Triangulo : FormaGeometrica
    {
        double basee;
        double lado1;
        double lado2;

        public Triangulo(double basee, double lado1, double lado2)
        {
            this.basee = basee;
            this.lado1 = lado1;
            this.lado2 = lado2;
        }

        public override double CalcularArea()
        {
            double area = (basee * lado1) / 2;
            return area;
        }

        public override double CalcularPerimetro()
        {
            double perimetro = basee + lado1 + lado2;
            return perimetro;
        }

        public void Desenhar()
        {
            Console.WriteLine("🔺");
        }
    }
}
