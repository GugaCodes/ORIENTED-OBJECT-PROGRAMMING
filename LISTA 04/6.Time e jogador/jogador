using System;
using System.Collections.Generic;
using System.Text;

namespace POO_EXERCICIOS
{
    public class Jogador
    {
        public string nomeJogador;
        public string posicaoJogador;

        public void AdicionarAoTime(string nome,  Time clube)
        {
            clube.Contratar(nomeJogador, posicaoJogador, clube);
        }

        public void RemoverDoTime(string nome, Time clube)
        {
            clube.Rescindir(nomeJogador);
        }
    }

   
}
