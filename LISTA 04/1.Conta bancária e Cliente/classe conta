namespace Exercicio1
{
    public class ContaBancária
    {
        public Dictionary<string, double> Saldo = new Dictionary<string, double>();

        public void Depositar(double valor, string cpf)
        {

            Saldo[cpf] += valor;

        }

        public void Sacar(double valor, string cpf)
        {
            if (!Saldo.ContainsKey(cpf))
            {
                Console.WriteLine("Erro ao Sacar: Conta Não Existente");
                Console.WriteLine("Criando Conta....");
                CriarConta(cpf);
                
            }

            if (Saldo[cpf] < valor)
            {
                Console.WriteLine("Saldo Insuficiente");
                return;
            }
            else if (valor < 0)
            {
                Console.WriteLine("Valor Não reconhecido");
                return;
            }
            else
            {
                Saldo[cpf] -= valor;
                Console.WriteLine("Saque Efetuado com Sucesso");
            }


        }

        public void MostrarDados(Cliente cliente)
        {
            if (!Saldo.ContainsKey(cliente.Cpf))
            {
                Console.WriteLine("Erro ao mostrar dados: Conta Não Existente");
                return;
            }
            Console.WriteLine($"Nome: {cliente.Nome}\nSaldo: {Saldo[cliente.Cpf]}");
        }

        public void CriarConta(string cpf){
            Saldo.Add(cpf, 250);
            Console.WriteLine("Conta Criada com Sucesso");
            
            
        }




    }

}
