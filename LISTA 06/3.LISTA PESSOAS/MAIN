Aluno aluno1 = new Aluno("Gustavo", 20, "BCC");
Aluno aluno2 = new Aluno("Mario", 22, "BCC");
Pessoa pessoa1 = new Pessoa("Guilherme", 13);

List<Pessoa> listaPessoa = new List<Pessoa>();

listaPessoa.Add(pessoa1);
listaPessoa.Add(aluno1);
listaPessoa.Add(aluno2);

foreach(Pessoa pessoa in listaPessoa)
{
        Console.WriteLine(pessoa.GetNome());
    
}
