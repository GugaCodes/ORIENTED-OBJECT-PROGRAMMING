


Random random = new Random();
List<int> lista  = new List<int>();
int maior = 0;
int cont = 0;

for(int i = 0; i <=20; i++)
{
    int num = random.Next(1,501);
    lista.Add(num);

    if (lista[i] > maior)
    {
        maior = lista[i];
    }
    if (lista[i] % 2 == 0)
    {
        cont++;
    }
}


foreach(int numero in lista)
{
    Console.WriteLine(numero);
}
    Console.WriteLine($"O maior numero eh: {maior}");
    Console.WriteLine($"A lista possui {cont} numeros pares");
